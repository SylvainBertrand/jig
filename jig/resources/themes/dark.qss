/* Jig Dark Theme — VS Code / Foxglove inspired */

/* ================================================================
   Global defaults
   ================================================================ */

* {
    font-family: "Segoe UI", "SF Pro Text", "Ubuntu", "Noto Sans", sans-serif;
    font-size: 12px;
    color: #cccccc;
    outline: none;
}

QWidget {
    background-color: #1e1e1e;
}

/* ================================================================
   Main Window
   ================================================================ */

QMainWindow {
    background-color: #1e1e1e;
}

QMainWindow::separator {
    background: #3c3c3c;
    width: 2px;
    height: 2px;
}

QMainWindow::separator:hover {
    background: #007acc;
}

/* ================================================================
   Menu bar
   ================================================================ */

QMenuBar {
    background-color: #2d2d2d;
    border-bottom: 1px solid #3c3c3c;
    padding: 1px 0;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    border-radius: 2px;
}

QMenuBar::item:selected {
    background: #094771;
}

QMenuBar::item:pressed {
    background: #094771;
}

/* ================================================================
   Menus / context menus
   ================================================================ */

QMenu {
    background-color: #252526;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 4px 0;
}

QMenu::item {
    padding: 5px 28px 5px 20px;
    border-radius: 2px;
    margin: 1px 4px;
}

QMenu::item:selected {
    background-color: #094771;
}

QMenu::item:disabled {
    color: #5a5a5a;
}

QMenu::separator {
    height: 1px;
    background: #3c3c3c;
    margin: 4px 8px;
}

QMenu::indicator {
    width: 14px;
    height: 14px;
    margin-left: 4px;
}

/* ================================================================
   Dock widgets (QDockWidget — sidebar)
   ================================================================ */

QDockWidget {
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
    font-size: 11px;
    color: #808080;
}

QDockWidget::title {
    background: #2d2d2d;
    text-align: left;
    padding: 4px 8px;
    border-bottom: 1px solid #3c3c3c;
}

QDockWidget::close-button,
QDockWidget::float-button {
    background: transparent;
    border: none;
    padding: 2px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background: #3c3c3c;
    border-radius: 2px;
}

/* ================================================================
   Toolbar (timeline bar, etc.)
   ================================================================ */

QToolBar {
    background-color: #2d2d2d;
    border-top: 1px solid #3c3c3c;
    spacing: 4px;
    padding: 2px;
}

QToolBar::separator {
    width: 1px;
    background: #3c3c3c;
    margin: 2px 4px;
}

/* ================================================================
   Status bar
   ================================================================ */

QStatusBar {
    background-color: #007acc;
    color: #ffffff;
    font-size: 11px;
    min-height: 22px;
    border: none;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: #ffffff;
    padding: 0 6px;
}

/* ================================================================
   Buttons
   ================================================================ */

QPushButton {
    background-color: #2d2d2d;
    border: 1px solid #3c3c3c;
    border-radius: 3px;
    padding: 4px 10px;
    color: #cccccc;
    font-size: 11px;
    min-height: 18px;
}

QPushButton:hover {
    background-color: #3c3c3c;
    border-color: #505050;
}

QPushButton:pressed {
    background-color: #094771;
    border-color: #007acc;
}

QPushButton:checked {
    background-color: #094771;
    border-color: #007acc;
}

QPushButton:disabled {
    color: #5a5a5a;
    background-color: #252526;
    border-color: #333333;
}

/* ================================================================
   Combo boxes
   ================================================================ */

QComboBox {
    background-color: #3c3c3c;
    border: 1px solid #3c3c3c;
    border-radius: 3px;
    padding: 3px 8px;
    color: #cccccc;
    font-size: 11px;
    min-height: 18px;
}

QComboBox:hover {
    border-color: #505050;
}

QComboBox:focus {
    border-color: #007acc;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #808080;
    margin-right: 6px;
}

QComboBox QAbstractItemView {
    background-color: #252526;
    border: 1px solid #3c3c3c;
    selection-background-color: #094771;
    selection-color: #ffffff;
    padding: 2px;
}

/* ================================================================
   Line edits / search boxes
   ================================================================ */

QLineEdit {
    background-color: #3c3c3c;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 4px 8px;
    color: #cccccc;
    font-size: 12px;
    selection-background-color: #094771;
}

QLineEdit:focus {
    border-color: #007acc;
}

QLineEdit::placeholder {
    color: #5a5a5a;
}

/* ================================================================
   Check boxes
   ================================================================ */

QCheckBox {
    spacing: 4px;
    font-size: 11px;
    color: #cccccc;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #555555;
    border-radius: 2px;
    background: #3c3c3c;
}

QCheckBox::indicator:checked {
    background: #007acc;
    border-color: #007acc;
}

QCheckBox::indicator:hover {
    border-color: #007acc;
}

/* ================================================================
   Tree views (variable browser)
   ================================================================ */

QTreeWidget, QTreeView {
    background-color: #1e1e1e;
    border: none;
    font-size: 11px;
    alternate-background-color: #1e1e1e;
}

QTreeWidget::item, QTreeView::item {
    padding: 2px 4px;
    border: none;
    min-height: 22px;
}

QTreeWidget::item:hover, QTreeView::item:hover {
    background-color: #2a2a2e;
}

QTreeWidget::item:selected, QTreeView::item:selected {
    background-color: #094771;
    color: #ffffff;
}

QTreeWidget::branch {
    background: transparent;
}

QHeaderView::section {
    background-color: #2d2d2d;
    color: #808080;
    border: none;
    border-right: 1px solid #3c3c3c;
    border-bottom: 1px solid #3c3c3c;
    padding: 4px 8px;
    font-size: 11px;
}

/* ================================================================
   List views (quick plot dialog)
   ================================================================ */

QListWidget, QListView {
    background-color: #1e1e1e;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    font-size: 11px;
}

QListWidget::item, QListView::item {
    padding: 4px 8px;
    border: none;
    min-height: 20px;
}

QListWidget::item:hover, QListView::item:hover {
    background-color: #2a2a2e;
}

QListWidget::item:selected, QListView::item:selected {
    background-color: #094771;
    color: #ffffff;
}

/* ================================================================
   Sliders (timeline scrub bar)
   ================================================================ */

QSlider::groove:horizontal {
    height: 4px;
    background: #3c3c3c;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #cccccc;
    width: 12px;
    height: 12px;
    margin: -4px 0;
    border-radius: 6px;
}

QSlider::handle:horizontal:hover {
    background: #007acc;
}

QSlider::sub-page:horizontal {
    background: #007acc;
    border-radius: 2px;
}

/* ================================================================
   Scroll bars
   ================================================================ */

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #555555;
    min-height: 30px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #686868;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    height: 0;
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #555555;
    min-width: 30px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #686868;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    width: 0;
    background: transparent;
}

/* ================================================================
   Scroll area
   ================================================================ */

QScrollArea {
    background-color: #1e1e1e;
    border: none;
}

/* ================================================================
   Tab bar (PyQtAds dock tabs)
   ================================================================ */

QTabBar {
    background: #2d2d2d;
}

QTabBar::tab {
    background: #2d2d2d;
    color: #808080;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 6px 16px;
    font-size: 11px;
    min-width: 60px;
}

QTabBar::tab:hover {
    color: #cccccc;
    background: #333333;
}

QTabBar::tab:selected {
    color: #ffffff;
    border-bottom: 2px solid #007acc;
}

/* ================================================================
   Splitter handles
   ================================================================ */

QSplitter::handle {
    background: #3c3c3c;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter::handle:hover {
    background: #007acc;
}

/* ================================================================
   Tooltips
   ================================================================ */

QToolTip {
    background-color: #252526;
    color: #cccccc;
    border: 1px solid #3c3c3c;
    border-radius: 2px;
    padding: 4px 6px;
    font-size: 11px;
}

/* ================================================================
   Dialog
   ================================================================ */

QDialog {
    background-color: #252526;
}

/* ================================================================
   Labels — default transparent background
   ================================================================ */

QLabel {
    background: transparent;
    color: #cccccc;
}

/* ================================================================
   Panel toolbar (PanelToolbar widget)
   ================================================================ */

PanelToolbar {
    background: #2d2d2d;
    border-bottom: 1px solid #3c3c3c;
}

/* ================================================================
   Frame
   ================================================================ */

QFrame {
    border: none;
}
